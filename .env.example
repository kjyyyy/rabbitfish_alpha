# copy to .env and fill in; never commit .env
ANTHROPIC_API_KEY=
# for OpenAI itself; for local Ollama any non-empty value works
OPENAI_API_KEY=ollama

# storage: leave unset for SQLite at runs/alphalab.db
# DATABASE_URL=postgresql+psycopg://alphalab:alphalab@localhost:5432/alphalab

# inside docker compose the model servers are service names, not localhost
# ALPHALAB_LLM_BASE_URL=http://ollama:11434/v1
# POSTGRES_PASSWORD=change-me-in-anything-shared
